# Server-only credentials. Never use NEXT_PUBLIC_ for these.
BROWSER_USE_API_KEY=
# openssl rand -hex 32; used to sign the operator session cookie
DASHBOARD_ACCESS_TOKEN=
# openssl rand -hex 32; AES-256-GCM master key, exactly 64 hex chars
VAULT_MASTER_KEY=
# Persistent encrypted data directory. Single Node process / persistent disk required.
VELOVISA_DATA_DIR=.velovisa
# Approved portal/auth hosts, comma-separated. Configure actual pathway URLs before running.
VISA_PORTAL_HOSTS=immi.homeaffairs.gov.au,online.immi.gov.au,skillselect.gov.au,euprava.gov.rs,welcometoserbia.gov.rs,e-ikamet.goc.gov.tr,www.mom.gov.sg,www.ica.gov.sg,www.gosuslugi.ru,esd.imi.gov.my,xpatsgateway.com.my,www.qiwa.sa,muqeem.sa,www.lmra.gov.bh
# Optional private Python service
PYTHON_BACKEND_URL=http://127.0.0.1:8000
PYTHON_SERVICE_TOKEN=
